{
  "name": "dsh-destinywind-memory",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "长期记忆库：以 SQLite（memory.sqlite）保存，正文原样存取不受 Markdown 语法干扰；记忆注入所有会话的系统提示，硬性约束额外强化一次。",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src/store-sqlite.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/store-sqlite.test.mjs && node tests/memory-bank.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
